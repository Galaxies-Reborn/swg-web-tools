{
  "name": "@precu/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./data/*": "./data/*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --emitDeclarationOnly false --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "gen": "node scripts/generate-domain-data.mjs",
    "test": "tsx --test src/*.test.ts",
    "clean": "rimraf dist .turbo",
    "gen:city": "node scripts/generate-city-data.mjs",
    "gen:ships": "node scripts/generate-ship-data.mjs",
    "gen:schematics": "node scripts/generate-schematic-data.mjs",
    "gen:all": "node scripts/generate-domain-data.mjs && node scripts/generate-city-data.mjs && node scripts/generate-ship-data.mjs && node scripts/generate-schematic-data.mjs && node scripts/generate-ship-attachments.mjs",
    "gen:attachments": "node scripts/generate-ship-attachments.mjs"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
